<?xml version="1.0" encoding="UTF-8"?>
<plugin id="com.bank.ekyc.faceauth" version="1.0.0"
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <name>FaceAuthPlugin</name>

    <js-module src="www/faceauth.js" name="FaceAuthPlugin">
        <clobbers target="cordova.plugins.faceauth"/>
    </js-module>

    <platform name="android">

        <!-- Plugin Registration -->
        <config-file target="config.xml" parent="/*">
            <feature name="FaceAuthPlugin">
                <param name="android-package" value="com.bank.faceauth.FaceAuthPlugin"/>
            </feature>
        </config-file>

        <!-- Permissions -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.CAMERA"/>
            <uses-permission android:name="android.permission.INTERNET"/>
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
        </config-file>

        <!-- FaceRD detection -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <queries>
                <package android:name="in.gov.uidai.facerd"/>
            </queries>
        </config-file>

        <!-- Java file -->
        <source-file src="src/android/FaceAuthPlugin.java" target-dir="src/com/bank/faceauth"/>

        <!-- AAR SDK -->
        <source-file src="src/android/libs/ekyc-setu-sdk.aar" target-dir="app/libs"/>

        <!-- Gradle -->
        <framework src="src/android/faceauth.gradle" custom="true" type="gradleReference"/>

    </platform>
</plugin>
